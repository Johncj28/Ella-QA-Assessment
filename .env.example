# Copy this file to `.env` and adjust the values for your environment:
#   cp .env.example .env
#
# These variables are read by the NestJS app (src/app.module.ts),
# the TypeORM CLI (data-source.ts) and Docker Compose.
# See devops/environment-notes.md for per-environment values (dev / test / staging).

# ---- Application ----
PORT=4000
# NODE_ENV=development          # docker-compose.yml forces `production` inside the container
# APP_VERSION=local             # image tag + reported by GET /health

# ---- Database (PostgreSQL) ----
# When running the app locally against the Docker DB, use localhost.
# When running the app *inside* Docker Compose, DB_HOST/DB_PORT are overridden to db:5432.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ella

# ---- Docker Compose host ports (optional) ----
# Change these if 4000/5432 are already taken on your machine.
# API_HOST_PORT=4000
# DB_HOST_PORT=5432
