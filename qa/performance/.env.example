# Pass values to k6 with -e, e.g.  k6 run -e BASE_URL=http://localhost:4000 tests/user/smoke.js
ENV=local                # key in src/config/enviroment.js
BASE_URL=http://localhost:4000
THINK_TIME_MIN=1         # seconds between user steps (random between min and max)
THINK_TIME_MAX=5         # 0 = no think time
RATE_SCALE=1             # multiply all arrival rates (e.g. 0.1 for a weak environment)
SOAK_DURATION=2h
SEED_USERS=20
SEED_PRODUCTS=5
PRODUCT_LIST_EVERY=10    # fetch full GET /products every Nth iteration (0 = never)
INFLUX_URL=http://localhost:8086/k6
